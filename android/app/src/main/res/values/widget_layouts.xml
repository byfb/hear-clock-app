<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A new size needs a new host measurement. LinearLayout.setWeightSum does not request one. -->
    <item type="layout" name="clock_widget_small">@layout/clock_widget</item>
    <item type="layout" name="clock_widget_medium">@layout/clock_widget</item>
    <!-- A fresh view drops the previous tap listener and its accessibility click action. -->
    <item type="layout" name="clock_widget_silent">@layout/clock_widget</item>
    <item type="layout" name="clock_widget_medium_silent">@layout/clock_widget</item>
    <item type="layout" name="clock_widget_small_silent">@layout/clock_widget</item>
    <item type="layout" name="clock_analog_silent">@layout/clock_analog</item>
</resources>
