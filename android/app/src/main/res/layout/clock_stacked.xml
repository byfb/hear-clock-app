<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_surface" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:importantForAccessibility="noHideDescendants">
        <TextClock android:id="@+id/stack_hour" style="@style/StackLine"/>
        <TextClock android:id="@+id/stack_minute" style="@style/StackLine"/>
    </LinearLayout>
    <TextClock android:id="@id/widget_clock" style="@style/ClockAction"/>
</FrameLayout>
